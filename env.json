{
  "project_name": "Apple Music Downloader GUI",
  "version": "1.0.0",
  "python": {
    "version_required": ">=3.10",
    "pip_packages": [
      "customtkinter>=5.2.0",
      "pillow>=10.0.0",
      "pyinstaller>=6.0.0"
    ]
  },
  "directories_to_create": [
    "internal",
    "AM-Lossless",
    "AM-AAC",
    "AM-Atmos"
  ],
  "external_tools": [
    {
      "name": "amdl",
      "description": "Apple Music CLI downloader",
      "repo_url": "https://github.com/zhaarey/apple-music-downloader",
      "api_release_url": "https://api.github.com/repos/zhaarey/apple-music-downloader/releases/latest",
      "download_url": "https://github.com/zhaarey/apple-music-downloader/releases/latest/download/amdl.exe",
      "target_dir": "internal",
      "executable": "amdl.exe",
      "type": "binary"
    },
    {
      "name": "wrapper-lite",
      "description": "Apple Music decryption wrapper backend (QEMU Windows x86_64)",
      "repo_url": "https://github.com/WorldObservationLog/wrapper",
      "api_release_url": "https://api.github.com/repos/WorldObservationLog/wrapper/releases/latest",
      "download_url": "https://github.com/WorldObservationLog/wrapper/releases/latest/download/wrapper-lite-qemu-windows-x86_64.zip",
      "target_dir": "internal",
      "extract_folder_name": "wrapper-lite-qemu-windows-x86_64",
      "executable": "wrapper-lite-qemu-windows-x86_64/wrapper-lite-qemu.exe",
      "type": "zip"
    },
    {
      "name": "ffmpeg",
      "description": "Audio converter m4a to mp3 320k",
      "repo_url": "https://github.com/GyanD/codexffmpeg",
      "download_url": "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip",
      "target_dir": "internal",
      "extract_bin": "bin/ffmpeg.exe",
      "executable": "ffmpeg.exe",
      "type": "zip_extract_binary"
    }
  ]
}